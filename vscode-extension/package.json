{
  "name": "codex-done-sound",
  "displayName": "%displayName%",
  "description": "%description%",
  "version": "1.2.5",
  "publisher": "yaruani",
  "license": "SEE LICENSE IN LICENSE",
  "icon": "images/icon.png",
  "pricing": "Free",
  "engines": {
    "vscode": "^1.101.0"
  },
  "categories": [
    "Other"
  ],
  "keywords": [
    "codex",
    "notification",
    "sound",
    "completion",
    "openai",
    "productivity"
  ],
  "extensionKind": [
    "ui"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./src/extension.js",
  "repository": {
    "type": "git",
    "url": "https://github.com/Yaruani/chatgpt-codex-completion-sound.git"
  },
  "homepage": "https://github.com/Yaruani/chatgpt-codex-completion-sound#readme",
  "bugs": {
    "url": "https://github.com/Yaruani/chatgpt-codex-completion-sound/issues"
  },
  "galleryBanner": {
    "color": "#254C8E",
    "theme": "dark"
  },
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": true
    },
    "virtualWorkspaces": {
      "supported": true
    }
  },
  "contributes": {
    "commands": [
      {
        "command": "codexCompletionSound.openSettings",
        "title": "%command.openSettings%"
      },
      {
        "command": "codexCompletionSound.testSound",
        "title": "%command.testSound%"
      },
      {
        "command": "codexCompletionSound.selectSound",
        "title": "%command.selectSound%"
      },
      {
        "command": "codexCompletionSound.setVolume",
        "title": "%command.setVolume%"
      },
      {
        "command": "codexCompletionSound.toggle",
        "title": "%command.toggle%"
      },
      {
        "command": "codexCompletionSound.diagnostics",
        "title": "%command.diagnostics%"
      }
    ],
    "configuration": {
      "title": "%configuration.title%",
      "properties": {
        "codexCompletionSound.enabled": {
          "type": "boolean",
          "default": true,
          "scope": "window",
          "order": 10,
          "description": "%configuration.enabled.description%"
        },
        "codexCompletionSound.sound": {
          "type": "string",
          "default": "bell",
          "scope": "window",
          "order": 20,
          "enum": [
            "chime",
            "bell",
            "double",
            "soft",
            "microwave",
            "handbell",
            "game"
          ],
          "enumDescriptions": [
            "%configuration.sound.chime%",
            "%configuration.sound.bell%",
            "%configuration.sound.double%",
            "%configuration.sound.soft%",
            "%configuration.sound.microwave%",
            "%configuration.sound.handbell%",
            "%configuration.sound.game%"
          ],
          "description": "%configuration.sound.description%"
        },
        "codexCompletionSound.volumePercent": {
          "type": "integer",
          "default": 65,
          "minimum": 0,
          "maximum": 100,
          "multipleOf": 5,
          "scope": "window",
          "order": 30,
          "description": "%configuration.volume.description%"
        }
      }
    }
  },
  "scripts": {
    "test": "node --test test/*.test.js",
    "check": "node --check src/extension.js && node --check src/audio.js && node --check src/codex-log-monitor.js && node --check src/wav.js",
    "package": "npx --yes @vscode/vsce@latest package"
  }
}
